// エディタ外（ターミナル・エクスプローラー・パネル等）でも Ctrl+h/j/k/l で
// フォーカス移動できるようにする。エディタ内は VSCodeVim 側の設定が担当するため
// when: "!editorTextFocus" でエディタ以外のときだけ有効化している。
[
  { "key": "ctrl+h", "command": "workbench.action.navigateLeft", "when": "!editorTextFocus" },
  // ターミナル内では Ctrl+l をシェルに渡す（画面クリアを優先）ため terminalFocus を除外
  { "key": "ctrl+l", "command": "workbench.action.navigateRight", "when": "!editorTextFocus && !terminalFocus" },
  { "key": "ctrl+k", "command": "workbench.action.navigateUp", "when": "!editorTextFocus && !inQuickOpen" },
  { "key": "ctrl+j", "command": "workbench.action.navigateDown", "when": "!editorTextFocus && !inQuickOpen" },
  // クイックオープン（ファイル検索/コマンドパレット）の候補を上下移動: Ctrl+j / Ctrl+k
  { "key": "ctrl+j", "command": "workbench.action.quickOpenSelectNext", "when": "inQuickOpen" },
  { "key": "ctrl+k", "command": "workbench.action.quickOpenSelectPrevious", "when": "inQuickOpen" },
  // ペイン（エディタグループ）のリサイズ: Cmd+Ctrl+矢印
  // ※ macOS の Mission Control と衝突する Ctrl+矢印を避けた割り当て
  // ※ 矢印の向きと境界の動きが一致するよう増減を割り当て
  { "key": "cmd+ctrl+left", "command": "workbench.action.decreaseViewWidth" },
  { "key": "cmd+ctrl+right", "command": "workbench.action.increaseViewWidth" },
  { "key": "cmd+ctrl+up", "command": "workbench.action.decreaseViewHeight" },
  { "key": "cmd+ctrl+down", "command": "workbench.action.increaseViewHeight" },

  // ── 統合ターミナル: Cmd+C / Cmd+V をコピー/貼付にする（GUI Linux のみ）──
  // GUI Linux では xremap が VSCode の Super(Cmd)+C/V を Ctrl+C/V に変換する。ところが
  // Linux 版 VSCode はターミナルのコピー/貼付を既定で Ctrl+Shift+C / Ctrl+Shift+V に
  // 置いており、Ctrl+C / Ctrl+V はシェルへ素通しする（Ctrl+C を copy に当てる既定は
  // win: だけに登録されている）。結果 Cmd+C が SIGINT、Cmd+V が無反応になる。
  //
  // xremap はエディタ部と統合ターミナル部を区別できない（同じ code ウィンドウ）ため、
  // ここでは VSCode 側の when 句で「選択の有無」を見て分岐させる。
  //   選択あり → コピー / 選択なし → 何も奪わずシェルへ = Ctrl+C は SIGINT のまま。
  // copyAndClearSelection はコピー後に選択を解除するので、続けて Ctrl+C を押せば中断
  // できる（Windows の既定と同じ挙動）。when 句と command は VSCode 既定の win: 側の
  // 定義に合わせてある。
  //
  // isLinux で囲っているのは macOS の挙動を変えないため（macOS では Cmd+C が別キーと
  // して届くので既定のままで正しく動く）。
  {
    "key": "ctrl+c",
    "command": "workbench.action.terminal.copyAndClearSelection",
    "when": "isLinux && (terminalTextSelectedInFocused || (terminalFocus && terminalTextSelected))"
  },
  { "key": "ctrl+v", "command": "workbench.action.terminal.paste", "when": "isLinux && terminalFocus" },

  // ターミナルパネルの表示切替。既定の Ctrl+` は無効化する。
  { "key": "alt+j", "command": "workbench.action.terminal.toggleTerminal", "when": "terminal.active" },
  { "key": "ctrl+`", "command": "-workbench.action.terminal.toggleTerminal", "when": "terminal.active" }
]
